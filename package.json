{
  "name": "opensidian",
  "productName": "OpenSidian",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "description": "OpenSidian — an independent, open-source replication of the Obsidian desktop app",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.3.0",
    "chokidar": "^3.6.0",
    "fix-webm-duration": "^1.0.6",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^10.9.8",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  },
  "author": "OpenSidian contributors",
  "homepage": "https://github.com/huxi7/opencidian",
  "repository": {
    "type": "git",
    "url": "https://github.com/huxi7/opencidian.git"
  }
}
