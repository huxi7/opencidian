{
  "name": "opensidian",
  "productName": "OpenSidian",
  "version": "1.14.4",
  "license": "AGPL-3.0-or-later",
  "description": "OpenSidian — an independent, open-source replication of the Obsidian desktop app",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run typecheck && node scripts/dev.mjs",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.strict.json",
    "test:unit": "node scripts/test-unit.mjs",
    "test:workspace": "node --experimental-vm-modules scripts/workspace-regression.mjs",
    "test:acceptance": "sh scripts/acceptance/full.sh",
    "test": "npm run build && npm run test:unit && npm run test:workspace"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.3.0",
    "chokidar": "^3.6.0",
    "dompurify": "3.4.17",
    "fix-webm-duration": "^1.0.6",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^10.9.8",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "22.20.5",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "6.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true
  },
  "author": "OpenSidian contributors",
  "homepage": "https://github.com/huxi7/opencidian",
  "repository": {
    "type": "git",
    "url": "https://github.com/huxi7/opencidian.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  }
}
